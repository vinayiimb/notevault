    "seed:note-themes": "tsx prisma/seed-note-themes.ts",
    "seed:demo-content-blocks": "tsx prisma/seed-demo-content-blocks.ts",
    "seed:admin-only": "tsx prisma/seed-admin-only.ts",
    "sync:drive-links": "tsx prisma/sync-all-drive-links.ts",
    "import:core-pyqs": "tsx prisma/import-core-pyqs.ts",
