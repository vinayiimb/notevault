// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer) connection for normal app queries.
  url       = env("DATABASE_URL")
  // Direct connection, used only for running migrations (pooled
  // connections can't create the shadow database Prisma needs to diff
  // schema changes against).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EducationLevel {
  SCHOOL
  COLLEGE
}

enum ResourceType {
  NOTES
  PYQ
}

enum NoteContentFormat {
  MARKDOWN
  STRUCTURED
}

enum NoteThemeScope {
  GLOBAL
  SUBJECT
  NOTE
}

enum BulkUploadRowStatus {
  VALID // required fields present, no dup — ready to import
  IMPORTED // admin approved, CatalogPaperUpload created
  SKIPPED // was VALID but admin didn't approve it at commit time
  DUPLICATE // fileHash already exists on a CatalogPaperUpload
  INVALID // missing required fields (course, subject, year range, or file URL)
}

// e.g. "CBSE Class 12", "B.Com (Hons)", "BBA"
model Program {
  id        String         @id @default(cuid())
  level     EducationLevel
  name      String
  slug      String         @unique
  summary   String?
  createdAt DateTime       @default(now())

  terms         Term[]
  sessionLinks  SessionProgramLink[]
  driveSubjects DriveSubject[]
}

// e.g. "Semester 1" for college, or just "Full Year" for school
model Term {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(1)
  createdAt DateTime @default(now())

  subjects         Subject[]
  termPapers       TermPaper[]
  mergeSuggestions SubjectMergeSuggestion[]

  @@unique([programId, order])
}

model Subject {
  id          String   @id @default(cuid())
  termId      String
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  // Official syllabus metadata. `name` remains the canonical display name;
  // aliases are approved historical/spelling variants used only for matching.
  upc         String?
  paperType   String?
  aliases     String[] @default([])
  createdAt   DateTime @default(now())

  // Hierarchical grouping only (e.g. "Income Tax Law and Practice I" under
  // parent "Income Tax Law and Practice") — the child stays a fully real,
  // independently browsable Subject. Distinct from mergedIntoId below.
  parentSubjectId String?
  parentSubject   Subject?  @relation("SubjectParent", fields: [parentSubjectId], references: [id], onDelete: SetNull)
  childSubjects   Subject[] @relation("SubjectParent")

  // Set once this Subject has been merged into another as a duplicate
  // (see Subject Normalization). When set, this row is deprecated: its
  // resources/questions have been reassigned to mergedInto, its original
  // name lives on as a SubjectAlias, and its public page permanently
  // redirects to mergedInto's. The row itself is kept (never deleted) so
  // the merge stays reversible and no historical reference breaks.
  mergedIntoId String?
  mergedInto   Subject?  @relation("SubjectMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Subject[] @relation("SubjectMerge")

  resources         Resource[]
  questions         Question[]
  analysis          SubjectAnalysis?
  notes             SubjectNotes?
  driveSubjects     DriveSubject[]
  noteThemes        NoteTheme[]
  examDates         StudentExamDate[]
  subjectAliases    SubjectAlias[]
  studyPlanSubjects StudyPlanSubject[]
  plannerTasks      PlannerTask[]
  units             Unit[]
  notesAI           Note[]            @relation("NoteSubject")
  quizzes           Quiz[]            @relation("QuizSubject")

  @@unique([termId, slug])
  @@index([upc])
  @@index([parentSubjectId])
  @@index([mergedIntoId])
}

enum AliasSource {
  IMPORT
  ADMIN
  AI
}

// A raw, as-imported subject-name variant that has been confirmed to refer
// to `subject` (the canonical row). Distinct from Subject.aliases (a plain
// string list used for quick official-name matching): this table carries
// per-alias provenance (source, confidence, who/when approved) needed for
// the Subject Normalization review workflow and audit trail.
model SubjectAlias {
  id                 String      @id @default(cuid())
  canonicalSubjectId String
  subject            Subject     @relation(fields: [canonicalSubjectId], references: [id], onDelete: Cascade)
  rawName            String
  normalizedName     String
  source             AliasSource @default(ADMIN)
  confidenceScore    Int? // 0-100, only set for AI-sourced aliases
  approvedBy         String? // admin id
  approvedAt         DateTime?
  createdAt          DateTime    @default(now())

  @@unique([canonicalSubjectId, normalizedName])
  @@index([normalizedName])
}

enum SubjectRelationship {
  EXACT_DUPLICATE
  SPELLING_VARIATION
  ABBREVIATION
  RENAMED_SYLLABUS
  RELATED_BUT_SEPARATE
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  IGNORED
  MERGED
}

// One candidate duplicate-subject group, produced by either the
// deterministic Stage A matcher or the Stage B AI grouping call, awaiting
// admin review. Never applied automatically (see subject-merge.ts) —
// approving/merging turns this into a SubjectMergeLog row.
model SubjectMergeSuggestion {
  id              String              @id @default(cuid())
  termId          String
  term            Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  suggestedName   String
  subjectIds      String[] // Subject ids proposed to belong to this group
  confidenceScore Int // 0-100
  explanation     String
  relationship    SubjectRelationship
  safeToMerge     Boolean             @default(true)
  warnings        String[]            @default([])
  source          AliasSource         @default(AI) // AI or deterministic (stored as ADMIN when hand-created)
  status          SuggestionStatus    @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([termId])
  @@index([status])
  @@index([confidenceScore])
}

// Permanent, reversible record of an applied merge. reassignments snapshots
// the exact prior subjectId for every moved Resource/Question so undoMerge
// can restore precisely, not just approximately.
model SubjectMergeLog {
  id                         String    @id @default(cuid())
  previousCanonicalSubjectId String // the subject id that got merged away
  newCanonicalSubjectId      String // the subject id it was merged into
  affectedResourceIds        String[]
  affectedQuestionIds        String[]
  reassignments              Json // { resources: {id: prevSubjectId}[], questions: {id: prevSubjectId}[] }
  administrator              String // admin id
  confidenceScore            Int?
  reason                     String?
  isAiAssisted               Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  undoneAt                   DateTime?
  undoneBy                   String?

  @@index([previousCanonicalSubjectId])
  @@index([newCanonicalSubjectId])
}

enum ScanScope {
  ALL
  PROGRAM
  TERM
  UNMAPPED
  SELECTED
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// One "Scan Archive with AI" run. Progress fields let the admin UI show a
// live counter and let a run be resumed (processedSubjects marks how far a
// scan got) instead of restarting from zero if interrupted.
model ScanRun {
  id                 String     @id @default(cuid())
  scope              ScanScope
  programId          String?
  termId             String?
  status             ScanStatus @default(PENDING)
  totalSubjects      Int        @default(0)
  processedSubjects  Int        @default(0)
  groupsFound        Int        @default(0)
  suggestionsCreated Int        @default(0)
  failedCount        Int        @default(0)
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime   @default(now())

  @@index([status])
}

// Admin-pasted, long-form compiled notes for a subject, rendered on the
// public subject page with its own styling — distinct from Resource rows of
// type NOTES, which are uploaded PDF files. `content` (markdown) is the
// original, still-supported format; `format`/`structuredJson` are the new
// AI/admin-authored path (see src/lib/note-schema.ts) — existing rows keep
// rendering through the old markdown path untouched since format defaults
// to MARKDOWN and structuredJson stays null for them.
// Notes keyed directly by the 118-programme canonical syllabus file
// (src/data/du-canonical-mapping.json), not by a Program/Term/Subject DB
// row — that hierarchy has duplicate/legacy programme rows (120 vs the
// syllabus's clean 118) and its Subject names don't reliably match the
// canonical ones. This table is the source of truth for the admin
// "drop a .md file per programme+subject" flow at /admin/subject-notes.
model CanonicalSubjectNote {
  id            String   @id @default(cuid())
  programmeSlug String
  programme     String
  subjectSlug   String
  subject       String
  content       String
  theme         String   @default("sky")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([programmeSlug, subjectSlug])
  @@index([programmeSlug])
}

model SubjectNotes {
  id             String            @id @default(cuid())
  subjectId      String            @unique
  subject        Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  content        String
  theme          String            @default("sky")
  format         NoteContentFormat @default(MARKDOWN)
  structuredJson Json?
  sourceFileUrl  String?
  sourceFileName String?
  updatedAt      DateTime          @updatedAt
  createdAt      DateTime          @default(now())

  noteTheme NoteTheme?
}

// A saved theme for the structured-notes design system (colors, typography,
// layout, component and diagram styling — see src/lib/note-theme.ts for the
// full field shape and src/lib/note-schema.ts's ThemeSchema for validation).
// Scoped GLOBAL (site default), SUBJECT (overrides for one subject's notes),
// or NOTE (overrides for one specific note) — resolveEffectiveTheme() merges
// GLOBAL -> SUBJECT -> NOTE, each layer filling gaps in the one below.
// draftJson is what the admin is currently editing; publishedJson is what's
// actually live. "Publish" snapshots the outgoing publishedJson into
// NoteThemeVersion first, so publishing never loses the prior version.
model NoteTheme {
  id              String         @id @default(cuid())
  name            String
  scope           NoteThemeScope
  subjectId       String?
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectNotesId  String?        @unique
  subjectNotes    SubjectNotes?  @relation(fields: [subjectNotesId], references: [id], onDelete: Cascade)
  // Seeded built-in presets (Scholar Blue, Botanical, Lavender Study, Rose
  // Ink, Midnight Focus) — never deletable, only duplicatable, so a preset
  // is always recoverable even after heavy customization elsewhere.
  isPreset        Boolean        @default(false)
  // Exactly one GLOBAL theme should have this true at a time (enforced in
  // src/lib/actions.ts, not the schema) — the fallback every subject/note
  // inherits from when it has no override of its own.
  isDefaultGlobal Boolean        @default(false)
  draftJson       Json
  publishedJson   Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  versions NoteThemeVersion[]

  @@index([scope])
  @@index([subjectId])
}

// A snapshot of a NoteTheme's publishedJson taken at the moment it was about
// to be replaced by a new publish — this is the whole "version history /
// restore previous version" feature: restoring just copies a chosen row's
// snapshotJson back into NoteTheme.publishedJson (and draftJson, so the
// editor reopens showing the restored state).
model NoteThemeVersion {
  id           String    @id @default(cuid())
  themeId      String
  theme        NoteTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  snapshotJson Json
  label        String?
  createdAt    DateTime  @default(now())

  @@index([themeId])
}

// Cached result of analyzing a subject's uploaded PYQ papers: AI-compiled
// notes, the most-repeated questions across years, and a predicted paper.
// Regenerated on demand (not automatically) since it costs a real AI call.
model SubjectAnalysis {
  id                  String   @id @default(cuid())
  subjectId           String   @unique
  subject             Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  compiledNotes       String
  mostRepeatedJson    String // JSON-encoded array
  predictedPaperJson  String // JSON-encoded array
  sourceResourceCount Int
  generatedAt         DateTime @default(now())
}

model Resource {
  id             String       @id @default(cuid())
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  type           ResourceType
  title          String
  year           Int?
  academicYear   String?
  fileUrl        String
  fileName       String
  fileSize       Int
  fileHash       String? // SHA-256 of the file bytes, used to reject duplicate uploads
  ocrText        String?      @db.Text
  ocrTextHash    String?
  sourceJsonName String?      @unique
  pageCount      Int?
  downloads      Int          @default(0)
  createdAt      DateTime     @default(now())
  batchId        String?
  batch          UploadBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // PYQ paper metadata surfaced on the tabbed /pyq-notes/[id] reading page
  // (Paper tab's PYQMetadata panel) — all optional/additive since most
  // historical rows predate this and were never asked for these fields.
  paperCode    String?
  session      String? // e.g. "May-June", "Nov-Dec"
  duration     String? // free text, e.g. "3 hours"
  maximumMarks Int?
  // Tracks where a scanned paper is in the OCR pipeline independently of
  // whether ocrText happens to be populated yet — lets the admin question
  // editor (Phase H) show a real status instead of guessing from null-ness.
  ocrStatus    OcrStatus @default(NOT_STARTED)

  questions Question[]

  @@index([fileHash])
  @@index([batchId])
}

enum OcrStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
}

// PDFs added from the catalog coverage screen. The 2,431 college-hosted
// source links live in the versioned static catalog; only new admin uploads
// need database rows and managed file storage.
model CatalogPaperUpload {
  id            String   @id @default(cuid())
  course        String
  subject       String
  yearRange     String
  semesterGroup String
  semester      Int?
  fileUrl       String
  fileName      String
  fileSize      Int
  fileHash      String   @unique
  note          String?
  createdAt     DateTime @default(now())

  bulkUploadRow BulkUploadRow?

  @@index([course, subject, yearRange])
}

// A separate, standalone table for the DU Question Paper Bank scrape
// (scripts/du-question-bank/) — deliberately NOT part of CatalogPaperUpload
// / the Full Archive union (getFullPyqCatalog), so it never mixes into
// /pyq-notes. Mirrors the "Full Archive Map" mapped-CSV's own columns
// directly rather than squeezing them into CatalogPaperUpload's narrower
// shape. Bulk-inserted via createMany with no per-row dedupe check — every
// row from the source file lands here as-is, duplicates included, since the
// point of this table is to hold the complete raw scrape output.
model DuQuestionBankPaper {
  id                   String   @id @default(cuid())
  officialProgramme    String
  semester             String?
  paperType            String?
  subjectPaperName     String
  courseNumber         String?
  upc                  String?
  credits              String?
  matchedCategories    String?
  sourceType           String?
  officialPageUrl      String?
  officialPaperLink    String?
  questionPaperLink    String?
  questionPaperSession String?
  questionPaperYear    String?
  questionPaperSet     String?
  questionPaperMarks   String?
  matchSource          String?
  recoveredUpc         String?
  createdAt            DateTime @default(now())

  @@index([officialProgramme])
  @@index([upc])
}

// Admin override layered on top of the Full Archive (/pyq-notes) at render
// time — lets an admin rename a subject, force which semester it's grouped
// under, or highlight it, without touching the underlying scraped library
// catalog, uploads, NoteVault resources, or Drive files it was built from.
// subjectKey is canonicalSubjectKey() of the ORIGINAL (pre-override) subject
// label, so it stays stable no matter what the admin renames it to.
// "Merging" two subjects is just giving both the same displayName +
// semesterOverride — canonicalSubjectKey() then hashes them to the same
// group in the archive browser, no separate merge-target column needed.
model CatalogSubjectOverride {
  id               String   @id @default(cuid())
  course           String
  subjectKey       String
  displayName      String?
  semesterOverride Int?
  highlight        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([course, subjectKey])
}

// A single combined paper covering every subject for one Program+Semester
// at once (as opposed to a Resource, which always belongs to one Subject) —
// e.g. a scanned "B.Com (H) Semester 1" booklet that bundles all subjects'
// question papers together instead of being split per subject. Shown on
// that term's public page alongside its per-subject resources.
model TermPaper {
  id           String       @id @default(cuid())
  termId       String
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  year         Int?
  academicYear String?
  fileUrl      String
  fileName     String
  fileSize     Int
  fileHash     String?
  batchId      String?
  batch        UploadBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([fileHash])
  @@index([batchId])
}

// A yearly/period exam session, e.g. "2026 (May-June)". Listed publicly as
// rows; each links to a program-level Google Drive folder table rather than
// individual files — Drive itself is the file browser at that level.
model ExamSession {
  id             String   @id @default(cuid())
  label          String   @unique // e.g. "2026 (May-June) Question Papers"
  order          Int      @default(0) // display order, desc = newest first
  masterDriveUrl String? // optional "ALL Search by Name" master-folder link
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  links SessionProgramLink[]
}

// One row per (session, program): the Drive folder for that program's
// papers in that session. Upserted on [sessionId, programId] so re-running
// an import is idempotent and never duplicates — this is what replaced the
// old per-Subject exact-name-match import, which silently created duplicate
// Subject rows whenever a name varied slightly between yearly imports.
model SessionProgramLink {
  id           String      @id @default(cuid())
  sessionId    String
  session      ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  programId    String
  program      Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  // Distinguishes multiple links to the same Program within one session —
  // e.g. DU's SEC/VAC/AEC electives all map to the single "Common Pool"
  // Program, but the spreadsheet gives each its own Drive folder. Empty
  // string (never null, so the unique index actually enforces uniqueness)
  // for the normal one-link-per-course case.
  variantLabel String      @default("")
  driveUrl     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  driveFiles DriveFileMatch[]

  @@unique([sessionId, programId, variantLabel])
}

// A subject derived directly from Drive PDF filenames (e.g. "Corporate
// Accounting  3319.pdf" -> "Corporate Accounting"), scoped to a Program so
// the same subject is reused across every session/year for that course
// instead of re-matching against the old, messy, code-prefixed Subject
// taxonomy (that legacy list stays exactly as-is elsewhere on the site —
// this is a separate, parallel structure just for the Drive-driven flow).
model DriveSubject {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional link to the canonical, syllabus-derived Subject catalog (DSC/DSE/SEC
  // named rows under the same Program's Term hierarchy). Several DriveSubject
  // naming variants across yearly syncs (e.g. "Company Law" and "Company Law III")
  // can point at the same catalog Subject — that's why this lives here rather than
  // the other direction. Nullable: most DriveSubjects start unlinked until an admin
  // or the auto-linker (prisma/link-drive-subjects-to-catalog.ts) confirms a match.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  files DriveFileMatch[]

  @@unique([programId, slug])
  @@index([subjectId])
}

// One PDF found inside a SessionProgramLink's Drive folder, matched to a
// DriveSubject derived from its own filename. We only store the Drive
// file's id and link here, never the bytes — the PDF stays on Google Drive.
model DriveFileMatch {
  id              String             @id @default(cuid())
  linkId          String
  link            SessionProgramLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  driveSubjectId  String?
  driveSubject    DriveSubject?      @relation(fields: [driveSubjectId], references: [id], onDelete: SetNull)
  driveFileId     String
  fileName        String
  webViewLink     String
  year            Int?
  // True when this file is a whole-course booklet (all subjects bundled in one
  // PDF, not yet split) rather than a single subject's paper — see
  // classifyDriveFilename in src/lib/subject-quality.ts. driveSubjectId is always
  // null on these rows; they're surfaced separately in the coverage UI as
  // "pending split" instead of being counted as a real subject.
  isCourseBooklet Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([linkId, driveFileId])
  @@index([driveSubjectId])
}

// One row per "Upload N files" click in Bulk Upload — lets the admin later
// browse back through what was uploaded together and fix a mistake (wrong
// year/subject/type) without having to hunt for the resource elsewhere.
model UploadBatch {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  // Original CSV/XLSX file name, set for batches created via the Bulk
  // Upload "Fresh Upload" flow (src/lib/bulk-upload.ts); null for other
  // batch-creating flows (e.g. single-file "Failed Upload" deploys).
  sourceFileName String?
  resources      Resource[]
  termPapers     TermPaper[]
  rows           BulkUploadRow[]
}

// One row per spreadsheet row from a Bulk Upload "Fresh Upload", persisted
// at validate time (before import) so the same records serve as both the
// admin's review screen and the permanent "Uploaded Data" audit trail.
// Imports into CatalogPaperUpload (the Full Archive catalog) — course and
// subject are free text here, same as CatalogPaperUpload itself, not
// matched against the curated Program/Term/Subject taxonomy.
model BulkUploadRow {
  id        String              @id @default(cuid())
  batchId   String
  batch     UploadBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  status    BulkUploadRowStatus
  message   String? // why invalid, or which catalog upload it duplicates

  // raw spreadsheet values, kept verbatim for display/debugging — mirrors
  // CatalogPaperUpload's own fields (course/subject/yearRange/semesterGroup/
  // semester/note), plus the file link/name.
  courseRaw        String
  subjectRaw       String
  yearRangeRaw     String?
  semesterGroupRaw String?
  semesterRaw      String?
  fileUrlRaw       String?
  fileNameRaw      String?
  noteRaw          String?

  catalogPaperUploadId String?             @unique
  catalogPaperUpload   CatalogPaperUpload? @relation(fields: [catalogPaperUploadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([status])
}

// A row an admin either couldn't assign a subject to, or that failed to
// upload, kept around (with the original file) so it isn't silently lost —
// visible on /admin/failed-uploads for the admin to fix and retry later.
model FailedUpload {
  id        String       @id @default(cuid())
  fileName  String
  title     String
  type      ResourceType
  year      Int?
  reason    String
  fileUrl   String?
  fileSize  Int?
  fileHash  String? // lets the admin see if this is a duplicate of an already-uploaded resource
  createdAt DateTime     @default(now())

  @@index([fileHash])
}

// Individual PYQ question, optionally linked back to the paper it appeared in.
// isRepeated + repeatCount + years power the "most repeated questions" feature.
model Question {
  id           String    @id @default(cuid())
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  resourceId   String?
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  questionText String
  answerText   String
  marks        Int?
  isRepeated   Boolean   @default(false)
  repeatCount  Int       @default(1)
  years        String? // comma-separated list of years this question appeared, e.g. "2021,2022,2024"
  createdAt    DateTime  @default(now())

  // Added for the admin per-question content editor (Phase H) and the PYQ
  // reading page's Searchable Text / Solutions tabs — all optional/additive,
  // every existing row keeps working with these unset.
  questionNumber String? // e.g. "3", "3(a)" — as printed on the paper
  section        String? // e.g. "Section A"
  rawOcrText     String?             @db.Text // unedited OCR output for this question, before correction
  topics         String[]            @default([])
  difficulty     QuestionDifficulty?
  // StudyContentBlock[] (src/lib/content/content-block-schema.ts), validated
  // app-side with zod rather than at the DB layer — lets a question's answer
  // carry LaTeX, tables, mermaid diagrams, charts, images, embedded PDF
  // references, callouts, and quiz blocks alongside the plain answerText.
  contentBlocks  Json?
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// A named, reusable StudyContentBlock (src/lib/content/content-block-schema.ts)
// admins can build once in the Content Blocks library (/admin/content-blocks)
// and insert by reference into any question's contentBlocks — e.g. a standard
// "Elasticity of Demand formula" block reused across many questions instead
// of re-typing the LaTeX each time.
model ContentBlock {
  id          String   @id @default(cuid())
  label       String
  description String?
  category    String?
  block       Json // a single StudyContentBlock, validated app-side with zod
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// Singleton row (id is always "singleton") for the small set of homepage
// text fields an admin can safely edit without any risk of breaking a page.
model SiteSettings {
  id                String   @id @default("singleton")
  heroEyebrow       String?
  heroHeadline      String?
  heroSubtitle      String?
  heroSearchCaption String?
  heroImageUrl      String?
  currencyIconUrl   String?
  updatedAt         DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// Learned filename/title -> subject associations for Bulk Upload. When an
// admin manually assigns a subject to a paper the filename-matching heuristic
// couldn't place, we remember it (keyed by a normalized title with trailing
// paper numbers stripped) so future uploads with a similar title auto-match.
model SubjectMatchMemory {
  id        String   @id @default(cuid())
  key       String   @unique
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Learned course-guess -> Program associations for Consolidated Upload. When
// an admin assigns a course to a detected group (a folder name, or an
// extracted course name from a flat dump of filenames) that the fuzzy
// matcher couldn't place on its own, we remember it — keyed by the same
// minimal-noise, synonym-canonicalized token key used for grouping — so a
// future upload with a similarly-worded but differently-punctuated or
// abbreviated filename ("Pol. Science" vs "Political Science") matches
// instantly instead of needing the same course picked again.
model CourseMatchMemory {
  id        String   @id @default(cuid())
  key       String   @unique
  programId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Anonymous, login-free student identity — one row per browser (device
// cookie), not a real account. Powers the streak / oranges / leaderboard
// mechanic without adding a password-based sign-up flow.
model Student {
  id             String   @id @default(cuid())
  deviceId       String   @unique
  nickname       String?
  oranges        Int      @default(0)
  streak         Int      @default(0)
  lastActiveDate String? // "YYYY-MM-DD", used to compute streak continuation
  createdAt      DateTime @default(now())

  events     OrangeEvent[]
  examDates  StudentExamDate[]
  studyPlans StudyPlan[]
}

// A manually-added upcoming exam date for a student's dashboard countdown.
// subjectName is denormalized so the entry still reads fine if the linked
// Subject is later deleted or renamed (subjectId is set null, not cascaded).
model StudentExamDate {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName String
  examDate    DateTime
  examTime    String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([studentId])
}

model OrangeEvent {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String // "daily_visit" | "resource_view" | "exam_kit_session"
  createdAt DateTime @default(now())
}

enum PlanStrategy {
  BALANCED
  PYQ_FOCUSED
  SYLLABUS_FIRST
  WEAK_TOPICS_FIRST
  LAST_MINUTE
  SMART_DU
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum PrepLevel {
  NOT_STARTED
  BASIC
  AVERAGE
  STRONG
}

enum TargetLevel {
  PASS
  GOOD_SCORE
  TOP_SCORE
}

enum TaskType {
  LEARN
  REVISE
  SOLVE_PYQS
  PRACTICE
  ATTEMPT_PAPER
  MOCK_TEST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
  RESCHEDULED
}

// A student's personalized study plan for one programme/term, tied to the
// same anonymous device-cookie Student used everywhere else on the site
// (see src/lib/student.ts) — no separate login required. One ACTIVE plan
// at a time is the expected usage; older plans are ARCHIVED, not deleted.
model StudyPlan {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId      String
  termId         String
  hoursWeekday   Int
  hoursWeekend   Int
  preferredTimes String[]     @default([]) // "morning" | "afternoon" | "evening" | "night"
  studyDays      String[]     @default([]) // enabled day codes, e.g. ["mon","tue",...]
  strategy       PlanStrategy @default(SMART_DU)
  status         PlanStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subjects StudyPlanSubject[]
  tasks    PlannerTask[]

  @@index([studentId, status])
}

// One row per subject included in a plan — the exam date, self-reported
// prep level, and target the scoring algorithm in src/lib/planner-data.ts
// weighs into task priority.
model StudyPlanSubject {
  id               String      @id @default(cuid())
  planId           String
  plan             StudyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examDate         DateTime
  examTime         String?
  preparationLevel PrepLevel   @default(NOT_STARTED)
  targetLevel      TargetLevel @default(GOOD_SCORE)

  @@unique([planId, subjectId])
}

// A single scheduled study task generated (or manually added) for a plan.
// `topic` is populated only when derivable from tagged Question.topics for
// the subject — most subjects don't have that data yet, so it stays null
// and the task is framed at subject/paper-year granularity instead.
model PlannerTask {
  id               String     @id @default(cuid())
  planId           String
  plan             StudyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic            String?
  type             TaskType
  title            String
  scheduledDate    DateTime
  estimatedMinutes Int
  priority         Int
  status           TaskStatus @default(TODO)
  resourceUrl      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([planId, scheduledDate])
}

// A message submitted through the public /feedback page, optionally with a
// screenshot attached. No login required — anyone can submit. Reviewed by
// an admin at /admin/feedback, where `read` tracks what's already been seen.
model Feedback {
  id             String   @id @default(cuid())
  message        String   @db.Text
  screenshotUrl  String?
  screenshotName String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([read])
}

// ----------------------------------------------------------------------
// AI NOTE VAULT / STUDY PLATFORM EXTENSIONS
// ----------------------------------------------------------------------

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders          Folder[]
  notes            Note[]
  sources          Source[]
  flashcards       Flashcard[]
  flashcardReviews FlashcardReview[]
  quizzes          Quiz[]
  quizAttempts     QuizAttempt[]
  mindMaps         MindMap[]
  studySessions    StudySession[]
  revisionHistory  RevisionHistory[]
  topicMastery     TopicMastery[]
  shares           Share[]
  comments         Comment[]
}

model Unit {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(1)
  createdAt DateTime @default(now())

  topics    Topic[]
  notes     Note[]
}

model Topic {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(1)
  status    String   @default("Not Started") // e.g., "Not Started", "Learning", "Revision Needed", "Completed"
  createdAt DateTime @default(now())

  notes           Note[]
  topicMasteries  TopicMastery[]
  syllabusTopics  SyllabusTopic[]
}

model SyllabusTopic {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?  @relation("FolderParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderParent")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes     Note[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  notes     NoteTag[]
}

model Note {
  id          String   @id @default(cuid())
  title       String
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  
  subjectId   String?
  subject     Subject? @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  
  isFavorite  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  isPublic    Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags        NoteTag[]
  blocks      NoteBlock[]
  attachments Attachment[]
  mindMaps    MindMap[]
  shares      Share[]
  comments    Comment[]
  flashcards  Flashcard[]
}

model NoteTag {
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model NoteBlock {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  type      String   // e.g., paragraph, heading_1, image, math, code_block
  content   String   @db.Text
  order     Int
  props     Json?    // Optional properties (e.g., text color, alignment)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
}

model Source {
  id        String   @id @default(cuid())
  title     String
  type      String   // PDF, DOCX, PPTX, IMAGE, URL, AUDIO
  url       String
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())
}

model Flashcard {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  front       String   @db.Text
  back        String   @db.Text
  type        String   // QUESTION_ANSWER, FILL_IN_BLANK
  createdAt   DateTime @default(now())

  reviews     FlashcardReview[]
}

model FlashcardReview {
  id          String   @id @default(cuid())
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      String   // AGAIN, HARD, GOOD, EASY
  reviewDate  DateTime @default(now())
  nextReview  DateTime?
}

model Quiz {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subjectId   String?
  subject     Subject? @relation("QuizSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  questions   QuizQuestion[]
  attempts    QuizAttempt[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String   @db.Text
  type          String   // MCQ, TRUE_FALSE, SHORT_ANSWER
  options       Json?
  correctAnswer String   @db.Text
  explanation   String?  @db.Text
  createdAt     DateTime @default(now())
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  createdAt   DateTime @default(now())
}

model MindMap {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String?
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  title     String
  data      Json     // The mindmap nodes and edges
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime @default(now())
  endTime   DateTime?
  duration  Int?     // in seconds
  type      String   // REVISION, QUIZ, READING
}

model RevisionHistory {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  topicId   String?
  date      DateTime @default(now())
  details   String?  @db.Text
}

model TopicMastery {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  level     String   // NEW, LEARNING, WEAK, GOOD, MASTERED
  updatedAt DateTime @updatedAt

  @@unique([userId, topicId])
}

model Share {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  ownerId     String   @db.Uuid
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  permission  String   // VIEW, COMMENT, EDIT
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ==============================================================================
// DU ACADEMIC INTELLIGENCE MODELS (Phase 0)
// ==============================================================================

model DuCourse {
  id               String            @id @default(cuid())
  canonicalTitle   String
  slug             String            @unique
  department       String?           
  courseType       String            // e.g., SEC, VAC, AEC, DSC, DSE, GE
  totalCredits     Int
  
  codes            DuCourseCode[]
  versions         DuCourseVersion[]
  createdAt        DateTime          @default(now())
}

model DuCourseCode {
  id               String            @id @default(cuid())
  upc              String            @unique
  courseId         String
  course           DuCourse          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status           String            @default("CURRENT") // CURRENT, LEGACY, TBA
}

model DuCourseVersion {
  id               String            @id @default(cuid())
  courseId         String
  course           DuCourse          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  scheme           String            @default("UGCF-2022")
  theoryCredits    Int               @default(0)
  tutorialCredits  Int               @default(0)
  practicalCredits Int               @default(0)
  
  assessmentRuleId String?
  assessmentRule   DuAssessmentRule? @relation(fields: [assessmentRuleId], references: [id])
  
  officialSourceId String?
  officialSource   DuOfficialSource? @relation(fields: [officialSourceId], references: [id])
  
  effectiveFrom    DateTime?
  status           String            @default("ACTIVE")
}

model DuAssessmentRule {
  id               String            @id @default(cuid())
  ruleIdentifier   String            @unique // e.g., "4CR-3L-1P"
  theoryMarks      Int               @default(0)
  internalAssess   Int               @default(0)
  tutorialCa       Int               @default(0)
  practicalCa      Int               @default(0)
  endTermPractical Int               @default(0)
  viva             Int               @default(0)
  totalMarks       Int               @default(0)
  theoryDuration   String?           // e.g., "3 hr"
  
  versions         DuCourseVersion[]
}

model DuOfficialSource {
  id               String            @id @default(cuid())
  authority        String            // e.g., "DU Academic Affairs"
  url              String?
  sourceType       String            // Formal Notification, Syllabus Page
  retrievedAt      DateTime          @default(now())
  authorityLevel   Int               @default(1) // 1=Formal, 2=Programme Page, etc.
  
  versions         DuCourseVersion[]
}

// The unified, static catalog of all papers (DU Question Bank + Ramanujan + Drive).
// Migrated from the static JSON file to allow database-level pagination and
// seamless integration with admin overrides.
model UnifiedCatalogPaper {
  id            String   @id
  yearRange     String
  semesterGroup String
  course        String
  subject       String
  semester      String?
  pdfUrl        String
  note          String?
  source        String
  isShivaji     Boolean  @default(false)
  isKalindi     Boolean  @default(false)
  isANDC        Boolean  @default(false)
  isRamanujan   Boolean  @default(false)
  college       String?
  fileName      String?
  createdAt     DateTime @default(now())

  @@index([course])
  @@index([subject])
  @@index([semester])
  @@index([yearRange])
}
